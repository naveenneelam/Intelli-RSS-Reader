<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.IntelliRss.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/filter_new_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/filter_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/filter_name_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/filter_enabled_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/filter_enabled" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/filter_match_all_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_match_all" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/filter_conditions"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <LinearLayout
                android:id="@+id/conditions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_condition"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/filter_add_condition"
                app:icon="@drawable/ic_add" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/filter_actions"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="?attr/colorOnSurface" />

            <CheckBox
                android:id="@+id/action_boost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_action_boost" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/filter_action_boost_amount">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/action_boost_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberSigned"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/action_mute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_action_mute" />

            <CheckBox
                android:id="@+id/action_notify"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_action_notify" />

            <CheckBox
                android:id="@+id/action_mark_read"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_action_mark_read" />

            <CheckBox
                android:id="@+id/action_archive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_action_archive" />

            <CheckBox
                android:id="@+id/action_tag"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/filter_action_tag" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/filter_action_tag_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/action_tag_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/filter_priority_hint"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
