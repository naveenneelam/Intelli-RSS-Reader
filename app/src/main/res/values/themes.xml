<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.IntelliRss" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorPrimaryContainer">@color/primary_container</item>
        <item name="colorOnPrimaryContainer">@color/on_primary_container</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSecondaryContainer">@color/secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/on_secondary_container</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurfaceContainer">@color/surface_elevated</item>
        <item name="colorSurfaceContainerHigh">@color/surface_elevated</item>
        <item name="colorSurfaceContainerHighest">@color/surface_variant</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.IntelliRss.Dialog</item>
        <item name="materialCardViewStyle">@style/Widget.IntelliRss.Card</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.IntelliRss.BottomSheet</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
    </style>

    <style name="ThemeOverlay.IntelliRss.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.IntelliRss.Dialog</item>
    </style>

    <style name="ThemeOverlay.IntelliRss.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="colorSurface">@color/surface_elevated</item>
        <item name="android:windowBackground">@color/transparent</item>
    </style>

    <style name="ShapeAppearance.IntelliRss.Dialog" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.IntelliRss.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="Widget.IntelliRss.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IntelliRss.Card</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.IntelliRss.Card.Elevated" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_elevated</item>
        <item name="cardElevation">2dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.IntelliRss.Card</item>
    </style>

    <style name="ThemeOverlay.IntelliRss.Accent.Teal" parent="">
        <item name="colorPrimary">@color/accent_teal</item>
        <item name="colorPrimaryContainer">@color/accent_teal_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
    </style>
    <style name="ThemeOverlay.IntelliRss.Accent.Blue" parent="">
        <item name="colorPrimary">@color/accent_blue</item>
        <item name="colorPrimaryContainer">@color/accent_blue_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
    </style>
    <style name="ThemeOverlay.IntelliRss.Accent.Cyan" parent="">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryContainer">@color/accent_cyan_container</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_container</item>
    </style>
    <style name="ThemeOverlay.IntelliRss.Accent.Amber" parent="">
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryContainer">@color/accent_amber_container</item>
        <item name="colorOnPrimaryContainer">#2A1800</item>
    </style>

    <style name="ThemeOverlay.IntelliRss.Reader" parent="">
        <item name="colorSurface">@color/reader_dark_bg</item>
        <item name="android:colorBackground">@color/reader_dark_bg</item>
        <item name="colorOnSurface">@color/reader_dark_text</item>
    </style>

    <style name="TextAppearance.IntelliRss.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.IntelliRss.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.IntelliRss.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.IntelliRss.ToolbarTitle</item>
        <item name="android:background">@color/background</item>
        <item name="titleCentered">false</item>
    </style>

    <style name="ShapeAppearance.IntelliRss.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.IntelliRss.Icon" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.IntelliRss.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.IntelliRss.ThumbnailTop" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.IntelliRss.StatBox" parent="">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.IntelliRss.StatValue" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.IntelliRss.StatLabel" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:layout_marginTop">2dp</item>
    </style>

    <style name="ShapeAppearance.IntelliRss.Sheet" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
